# Environment variables for Spor Toto Bot
# Copy this file to .env and fill in your values

# Database Configuration (if using external DB)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spor_toto
DB_USER=postgres
DB_PASSWORD=your_password_here

# API Keys (if using paid data sources)
FOOTBALL_API_KEY=your_api_key_here
BETTING_ODDS_API_KEY=your_api_key_here

# Data Source URLs
MACKOLIK_URL=https://www.mackolik.com
IDDAA_URL=https://www.iddaa.com
NESINE_URL=https://www.nesine.com

# Logging Level
LOG_LEVEL=INFO

# Model Configuration
RANDOM_SEED=42
TEST_SIZE=0.2
CV_FOLDS=5

# Feature Engineering
LOOKBACK_MATCHES=10
FORM_WINDOW=5
H2H_MATCHES=5

# Prediction Thresholds
CONFIDENCE_THRESHOLD=0.6
MIN_SUCCESS_PROBABILITY=0.15
